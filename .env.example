# Copia este archivo como .env y ajusta los valores
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DB_PATH=localmatch.db

# Proveedor del modelo de lenguaje: mock | ollama | anthropic
#  mock      -> sin LLM (extraccion por reglas + TF-IDF). Funciona sin internet.
#  ollama    -> modelo local (privacidad total): instala Ollama y haz "ollama pull llama3.1:8b"
#  anthropic -> API de Claude (los CV, ya anonimizados, salen de tu equipo)
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
