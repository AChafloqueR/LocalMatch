# Copia este archivo como .env (solo para desarrollo local)
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
DB_PATH=localmatch.db

# Base de datos de producción (PostgreSQL). Si la dejas vacía se usa SQLite local.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres

# Cuenta de investigación que se crea sola al iniciar (útil en servidores sin consola)
# ADMIN_EMAIL=tu-correo@ejemplo.com
# ADMIN_PASSWORD=una-contraseña-larga

HTTPS_ONLY=0

# Proveedor del modelo de lenguaje: mock | ollama | anthropic
LLM_PROVIDER=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Si es 1, el SUS se habilita solo cuando el participante completa su tarea
SUS_REQUIRE_TASK=1
